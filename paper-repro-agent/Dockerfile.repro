FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src \
    REPRO_RUNNER_STORAGE_DIR=/data/experiments

RUN apt-get update \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-repro.lock /tmp/requirements-repro.lock
RUN python -m pip install --requirement /tmp/requirements-repro.lock

RUN groupadd --system app \
    && useradd --system --gid app --home-dir /home/app --create-home app \
    && mkdir -p /data/experiments \
    && chown -R app:app /data/experiments /home/app

COPY --chown=app:app src /app/src

USER app
EXPOSE 8001

CMD ["uvicorn", "repro_runner.api:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]

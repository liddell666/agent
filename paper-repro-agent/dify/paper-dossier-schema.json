{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "source_text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source": {
          "enum": [
            "paper",
            "supplement",
            "repository",
            "user",
            "inferred"
          ],
          "title": "Source",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "page",
        "source_text",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceBackedFact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description",
        "evidence"
      ],
      "title": "EvidenceBackedFact",
      "type": "object"
    },
    "ReportedMetric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ReportedMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "research_problem": {
      "title": "Research Problem",
      "type": "string"
    },
    "task_type": {
      "title": "Task Type",
      "type": "string"
    },
    "datasets": {
      "items": {
        "$ref": "#/$defs/EvidenceBackedFact"
      },
      "title": "Datasets",
      "type": "array"
    },
    "methods": {
      "items": {
        "$ref": "#/$defs/EvidenceBackedFact"
      },
      "title": "Methods",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/ReportedMetric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "title",
    "research_problem",
    "task_type",
    "datasets",
    "methods",
    "metrics",
    "gaps"
  ],
  "title": "PaperDossier",
  "type": "object"
}
